# PaperPilot AI Environment Configuration
# Copy this file to .env and set your Google Gemini API key

# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini model (e.g., gemini-3.5-flash-lite, gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
